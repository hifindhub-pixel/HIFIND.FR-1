{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "img-src 'self' data: https://www.google.com https://*.gstatic.com https://images.unsplash.com;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, s-maxage=300" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/produit/:slug*", "destination": "/api/produit?slug=:slug*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
